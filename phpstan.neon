parameters:
    level: 6
    paths:
        - src
        - bin
    excludePaths:
        - vendor/*
        - .bona/*
        - rules/*
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        - identifier: missingType.iterableValue
        - identifier: missingType.generics
        - identifier: missingType.parameter
        - '#Parameter .* of function preg_match expects string, string\|false given#'
        - '#Parameter .* of function json_decode expects string, string\|false given#'

# SARIF formatter registration (per official README)
services:
    errorFormatter.sarif:
        class: PHPStanSarifErrorFormatter\SarifErrorFormatter
        arguments:
            relativePathHelper: @simpleRelativePathHelper
            currentWorkingDirectory: %currentWorkingDirectory%
            pretty: true
