parameters:
    level: 6
    paths:
        - src
        - bin
    excludePaths:
        - vendor/*
        - .bona/*
        - rules/*
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false

    # === Pragmatic ignores (audit tool, not consumed as library) ===
    ignoreErrors:
        # Iterable type hints are optional for internal tooling
        - identifier: missingType.iterableValue
        - identifier: missingType.generics
        - identifier: missingType.parameter

        # Tokenizer returns array|string — type narrowing needed
        - '#Parameter .* of function preg_match expects string, string\|false given#'

        # Dynamic exec/shell results
        - '#Parameter .* of function json_decode expects string, string\|false given#'
