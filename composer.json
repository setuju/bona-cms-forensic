{
    "name": "saturumah/bona-forensic",
    "description": "Enterprise Forensic Audit Tool for Bona CMS",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "Jack",
            "email": "Jack@saturumah.net"
        }
    ],
    "autoload": {
        "psr-4": {
            "SatuRumah\\Forensic\\": "src/"
        }
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*"
    },
    "bin": [
        "bin/forensic"
    ],
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0 || ^13.0",
        "phpstan/phpstan": "^1.12 || ^2.0",
        "jbelien/phpstan-sarif-formatter": "^1.2"
    },
    "scripts": {
        "phpstan": "phpstan analyse --level=8 --no-progress src bin"
    }
}
