#!/usr/bin/env php
<?php
declare(strict_types=1);

require_once __DIR__ . '/../vendor/autoload.php';

use SatuRumah\Forensic\Core\Config;
use SatuRumah\Forensic\Checkers\StatsChecker;
use SatuRumah\Forensic\Checkers\SecurityChecker;
use SatuRumah\Forensic\Checkers\DependencyChecker;
use SatuRumah\Forensic\Checkers\OrphanChecker;
use SatuRumah\Forensic\Checkers\LogChecker;
use SatuRumah\Forensic\Checkers\SeoChecker;
use SatuRumah\Forensic\Checkers\ClsChecker;
use SatuRumah\Forensic\Checkers\MaintenanceChecker;
use SatuRumah\Forensic\Checkers\ConfigChecker;
use SatuRumah\Forensic\Checkers\AdvancedSecurityChecker;
use SatuRumah\Forensic\Checkers\CircularDependencyChecker;

$target = getcwd();
$showFindings = in_array('--show-findings', $argv, true);
foreach ($argv as $arg) {
    if (str_starts_with($arg, '--root=')) $target = substr($arg, 7);
}

$config = new Config($target, $showFindings);

echo "\n\033[1;35m╔══════════════════════════════════════════════════════════════════════════╗\n";
echo "║     BONA FORENSIC — Enterprise Audit (Modular Architecture)              ║\n";
echo "╚══════════════════════════════════════════════════════════════════════════╝\033[0m\n";
echo "  Target : {$target}\n\n";

$checkers = [
    new StatsChecker($config),
    new MaintenanceChecker($config),
    new DependencyChecker($config),
    new CircularDependencyChecker($config),
    new OrphanChecker($config),
    new SecurityChecker($config),
    new AdvancedSecurityChecker($config),
    new ConfigChecker($config),
    new LogChecker($config),
    new SeoChecker($config),
    new ClsChecker($config),
];

$totalFails = 0;

foreach ($checkers as $checker) {
    echo "\033[1;36m▶ Running: " . $checker->getName() . "\033[0m\n";
    $results = $checker->run();
    
    foreach ($results as $res) {
        $icon = match($res['status']) {
            'PASS' => "\033[0;32m✓\033[0m",
            'FAIL' => "\033[0;31m✗\033[0m",
            'WARN' => "\033[0;33m⚠\033[0m",
            'SKIP' => "\033[0;90m○\033[0m",
            default => "\033[0;34mℹ\033[0m"
        };
        
        echo "  {$icon} {$res['message']}\n";
        
        if ($res['status'] === 'FAIL' || $res['status'] === 'WARN') {
            if ($res['status'] === 'FAIL') $totalFails++;
            if (!empty($res['details']['list']) && ($showFindings || $res['status'] === 'FAIL')) {
                foreach (array_slice($res['details']['list'], 0, 5) as $item) {
                    echo "      \033[2m- {$item}\033[0m\n";
                }
                if (count($res['details']['list']) > 5) echo "      \033[2m... dan " . (count($res['details']['list']) - 5) . " lainnya\033[0m\n";
            }
        }
    }
    echo "\n";
}

exit($totalFails > 0 ? 1 : 0);
