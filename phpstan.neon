parameters:
    level: 8
    paths:
        - src
        - bin
    excludePaths:
        - vendor/*
        - .bona/*
        - rules/*
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        # Allow dynamic calls in checker pattern matching
        - '#Cannot call method .* on mixed#'
        # Allow array access on mixed from file_get_contents results
        - '#Cannot access offset .* on mixed#'
        # Allow token_get_all result (returns array|string)
        - '#Parameter .* of function preg_match expects string, string\|false given#'
