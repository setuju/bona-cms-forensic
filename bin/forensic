#!/usr/bin/env php
<?php
declare(strict_types=1);

require_once __DIR__ . '/../vendor/autoload.php';

use SatuRumah\Forensic\Core\Config;
use SatuRumah\Forensic\Checkers\StatsChecker;
use SatuRumah\Forensic\Checkers\SecurityChecker;
use SatuRumah\Forensic\Checkers\DependencyChecker;
use SatuRumah\Forensic\Checkers\OrphanChecker;
use SatuRumah\Forensic\Checkers\LogChecker;
use SatuRumah\Forensic\Checkers\SeoChecker;
use SatuRumah\Forensic\Checkers\ClsChecker;
use SatuRumah\Forensic\Checkers\MaintenanceChecker;
use SatuRumah\Forensic\Checkers\ConfigChecker;
use SatuRumah\Forensic\Checkers\AdvancedSecurityChecker;
use SatuRumah\Forensic\Checkers\CircularDependencyChecker;
use SatuRumah\Forensic\Checkers\SnapshotChecker;
use SatuRumah\Forensic\Checkers\DatabaseChecker;
use SatuRumah\Forensic\Checkers\ImportDepthChecker;
use SatuRumah\Forensic\Checkers\CentralityChecker;
use SatuRumah\Forensic\Checkers\IntegrityChecker;
use SatuRumah\Forensic\Checkers\Php2ShellChecker;
use SatuRumah\Forensic\Checkers\SemgrepChecker;
use SatuRumah\Forensic\Checkers\PhpUnitChecker;
use SatuRumah\Forensic\Checkers\SmokeTestChecker;

$target = getcwd();
$showFindings = in_array('--show-findings', $argv, true);
$jsonMode = in_array('--json', $argv, true);
$onlySection = null;
foreach ($argv as $arg) {
    if (str_starts_with($arg, '--root=')) $target = substr($arg, 7);
    if (str_starts_with($arg, '--section=')) $onlySection = substr($arg, 10);
}

$config = new Config($target, $showFindings);

if (!$jsonMode) {
    echo "\n\033[1;35m╔══════════════════════════════════════════════════════════════════════════╗\n";
    echo "║     BONA FORENSIC — Enterprise Audit (Modular Architecture)              ║\n";
    echo "╚══════════════════════════════════════════════════════════════════════════╝\033[0m\n";
    echo "  Target : {$target}\n";
    if ($showFindings) echo "  Mode   : \033[1;33mFULL FINDINGS\033[0m\n";
    if ($onlySection !== null) echo "  Filter : \033[1;33m{$onlySection}\033[0m\n";
    echo "\n";
}

$checkers = [
    new StatsChecker($config),
    new MaintenanceChecker($config),
    new DependencyChecker($config),
    new CircularDependencyChecker($config),
    new ImportDepthChecker($config),
    new CentralityChecker($config),
    new OrphanChecker($config),
    new SecurityChecker($config),
    new AdvancedSecurityChecker($config),
    new ConfigChecker($config),
    new DatabaseChecker($config),
    new Php2ShellChecker($config),
    new SemgrepChecker($config),
    new PhpUnitChecker($config),
    new SmokeTestChecker($config),
    new LogChecker($config),
    new SeoChecker($config),
    new ClsChecker($config),
];

if ($onlySection !== null) {
    $checkers = array_filter($checkers, fn($c) => stripos($c->getName(), $onlySection) !== false);
    if (empty($checkers)) { echo "\033[0;31mNo section matched '{$onlySection}'\033[0m\n"; exit(1); }
}

$allResults = [];
$totalFails = 0;
$totalWarns = 0;

// Snapshot SEBELUM audit (untuk bukti read-only)
$integrity = new IntegrityChecker($config);
$integrity->snapshot();


foreach ($checkers as $checker) {
    $results = $checker->run();
    $allResults[$checker->getName()] = $results;
    
    if (!$jsonMode) {
        echo "\033[1;36m▶ Running: " . $checker->getName() . "\033[0m\n";
        foreach ($results as $res) {
            $icon = match($res['status']) {
                'PASS' => "\033[0;32m✓\033[0m", 'FAIL' => "\033[0;31m✗\033[0m",
                'WARN' => "\033[0;33m⚠\033[0m", 'SKIP' => "\033[0;90m○\033[0m", default => "\033[0;34mℹ\033[0m"
            };
            echo "  {$icon} {$res['message']}\n";
            if (in_array($res['status'], ['FAIL', 'WARN', 'INFO']) && !empty($res['details']['list'])) {
                $list = $res['details']['list'];
                $items = $showFindings ? $list : array_slice($list, 0, 10);
                foreach ($items as $item) echo "      \033[2m- {$item}\033[0m\n";
                if (!$showFindings && count($list) > 10) echo "      \033[2m... dan " . (count($list) - 10) . " lainnya\033[0m\n";
            }
        }
        echo "\n";
    }
    
    foreach ($results as $res) {
        if ($res['status'] === 'FAIL') $totalFails++;
        if ($res['status'] === 'WARN') $totalWarns++;
    }
}

if ($onlySection === null) {
    echo "\033[1;36m▶ Running: Read-Only Integrity Check\033[0m\n";
    $integrityResults = $integrity->run();
    $allResults['Read-Only Integrity Check'] = $integrityResults;
    foreach ($integrityResults as $res) {
        $icon = match($res['status']) { 'PASS' => "\033[0;32m✓\033[0m", 'FAIL' => "\033[0;31m✗\033[0m", 'WARN' => "\033[0;33m⚠\033[0m", default => "\033[0;34mℹ\033[0m" };
        echo "  {$icon} {$res['message']}\n";
        foreach (($res['details']['list'] ?? []) as $item) echo "      \033[2m- {$item}\033[0m\n";
    }
    echo "\n";
    
    $snapshotChecker = new SnapshotChecker($config, $allResults);
    $snapshotResults = $snapshotChecker->run();
    if (!$jsonMode) {
        echo "\033[1;36m▶ Running: Snapshot & Diff\033[0m\n";
        foreach ($snapshotResults as $res) {
            $icon = match($res['status']) { 'PASS' => "\033[0;32m✓\033[0m", 'WARN' => "\033[0;33m⚠\033[0m", 'INFO' => "\033[0;34mℹ\033[0m", default => "\033[0;90m○\033[0m" };
            echo "  {$icon} {$res['message']}\n";
        }
        echo "\n";
    }
}

if ($jsonMode) {
    echo json_encode(['meta' => ['target' => $target, 'timestamp' => date('c')], 'summary' => ['fails' => $totalFails, 'warns' => $totalWarns, 'status' => $totalFails > 0 ? 'FAIL' : ($totalWarns > 0 ? 'WARN' : 'PASS')], 'results' => $allResults], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n";
} else {
    echo "\033[1;35m══════════════════════════════════════════════════════════════════════════\033[0m\n";
    echo "\033[1;35m  SUMMARY\033[0m\n";
    echo "  Total FAILs : \033[0;31m{$totalFails}\033[0m\n";
    echo "  Total WARNs : \033[0;33m{$totalWarns}\033[0m\n";
    echo "  Status      : " . ($totalFails > 0 ? "\033[0;31mFAIL\033[0m" : ($totalWarns > 0 ? "\033[0;33mWARN\033[0m" : "\033[0;32mPASS\033[0m")) . "\n";
    echo "\033[1;35m══════════════════════════════════════════════════════════════════════════\033[0m\n\n";
}

exit($totalFails > 0 ? 1 : 0);
