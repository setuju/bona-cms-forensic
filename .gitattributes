* text=auto eol=lf

*.php text eol=lf linguist-language=PHP
*.phtml text eol=lf linguist-language=PHP
*.yaml text eol=lf linguist-language=YAML
*.yml text eol=lf linguist-language=YAML
*.md text eol=lf linguist-documentation
*.mmd text eol=lf

vendor/ linguist-vendored
.bona/ export-ignore
docs/ export-ignore
.github/ export-ignore
.editorconfig export-ignore
.gitattributes export-ignore
