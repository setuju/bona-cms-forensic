#!/usr/bin/env php
<?php
/**
 * ┌──────────────────────────────────────────────────────────────────────┐
 * │  ⌂  SATURUMAH.NET · FILE CONTRACT                                    │
 * │  ──────────────────────────────────────────────────────────────────  │
 * │  File      : bin/forensic
 * │  Purpose   : CLI entry point for Bona Forensic audit tool
 * │  Author    : Jack — Jack[at]SatuRumah[dot]Net                        │
 * │  GitHub    : https://github.com/setuju                               │
 * │  Website   : https://saturumah.net                                   │
 * │  Created   : 2026-10-26                                              │
 * │  License   : Proprietary — all rights reserved                       │
 * │                                                                      │
 * │  This header is the file contract. If it is missing, the file is     │
 * │  vendored, generated, or outside the project boundary.               │
 * └──────────────────────────────────────────────────────────────────────┘
 *
 * @author    Jack <Jack[at]SatuRumah[dot]Net>
 * @created   2026-10-26
 * @package   SatuRumah\Forensic\Bin
 * @license   Proprietary
 */

declare(strict_types=1);

require_once __DIR__ . '/../vendor/autoload.php';

use SatuRumah\Forensic\Core\Config;
use SatuRumah\Forensic\Checkers\StatsChecker;
use SatuRumah\Forensic\Checkers\SecurityChecker;
use SatuRumah\Forensic\Checkers\DependencyChecker;
use SatuRumah\Forensic\Checkers\OrphanChecker;
use SatuRumah\Forensic\Checkers\LogChecker;
use SatuRumah\Forensic\Checkers\SeoChecker;
use SatuRumah\Forensic\Checkers\ClsChecker;
use SatuRumah\Forensic\Checkers\MaintenanceChecker;
use SatuRumah\Forensic\Checkers\ConfigChecker;
use SatuRumah\Forensic\Checkers\AdvancedSecurityChecker;
use SatuRumah\Forensic\Checkers\CircularDependencyChecker;
use SatuRumah\Forensic\Checkers\SnapshotChecker;
use SatuRumah\Forensic\Checkers\DatabaseChecker;
use SatuRumah\Forensic\Checkers\ImportDepthChecker;
use SatuRumah\Forensic\Checkers\CentralityChecker;
use SatuRumah\Forensic\Checkers\TtfbChecker;
use SatuRumah\Forensic\Checkers\A11yChecker;
use SatuRumah\Forensic\Checkers\IntegrityChecker;
use SatuRumah\Forensic\Checkers\Php2ShellChecker;
use SatuRumah\Forensic\Checkers\SemgrepChecker;
use SatuRumah\Forensic\Checkers\PhpUnitChecker;
use SatuRumah\Forensic\Checkers\PageSpeedChecker;
use SatuRumah\Forensic\Checkers\BrokenLinksChecker;
use SatuRumah\Forensic\Checkers\AssetChecker;
use SatuRumah\Forensic\Checkers\ReliabilityChecker;
use SatuRumah\Forensic\Checkers\SmokeTestChecker;

$target = getcwd();
if (in_array('--help', $argv, true) || in_array('-h', $argv, true)) {
    fwrite(STDOUT, <<<USAGE
Bona Forensic — Enterprise READ-ONLY PHP Audit

Usage:
  ./bin/forensic [options]

Options:
  --root=PATH          Target directory (default: parent of repo)
  --ci                 Exit 1 on FAIL (CI mode)
  --json               Machine-readable JSON output
  --show-findings      Print detailed findings (list items)
  --section=NAME       Run only one section (stats, security, seo, ...)
  --ignore-path=PREFIX Skip a path prefix (repeatable)
  --quick              Skip slow checks (semgrep, tests)
  --report[=PATH]      Write markdown report
  --html[=PATH]        Write self-contained HTML report (default: .bona/report-*.html)
  --help, -h           Show this message
  --version            Show version

Exit codes:
  0 = PASS (0 FAIL)
  1 = FAIL (>=1 FAIL item; only with --ci)
  2 = error (missing files, gate failure)

USAGE
    );
    exit(0);
}

if (in_array('--version', $argv, true)) {
    $composerPath = __DIR__ . '/../composer.json';
    $version = '2.2.5';  // fallback: composer.json for apps has no 'version' key (update on release)
    if (is_readable($composerPath)) {
        $c = json_decode((string)file_get_contents($composerPath), true);
        if (is_array($c) && isset($c['version'])) $version = (string)$c['version'];
    }
    fwrite(STDOUT, "Bona Forensic {$version}\n");
    fwrite(STDOUT, "PHP " . PHP_VERSION . "\n");
    exit(0);
}

$showFindings = in_array('--show-findings', $argv, true);

$htmlFlag = null;
foreach ($argv as $arg) {
    if ($arg === '--html') { $htmlFlag = ''; }
    elseif (str_starts_with($arg, '--html=')) { $htmlFlag = substr($arg, 7); }
}
$jsonMode = in_array('--json', $argv, true);
$onlySection = null;
$skipSections = [];
$ignorePaths = [];
$reportPath = null;
foreach ($argv as $arg) {
    if (str_starts_with($arg, '--root=')) $target = substr($arg, 7);
    if (str_starts_with($arg, '--section=')) $onlySection = substr($arg, 10);
    if (str_starts_with($arg, '--ignore-path=')) {
        $p = rtrim(substr($arg, 14), '/') . '/';
        if ($p !== '/') $ignorePaths[] = $p;
    }
    if (str_starts_with($arg, '--skip=')) {
        foreach (explode(',', substr($arg, 7)) as $sk) {
            $sk = trim($sk);
            if ($sk !== '') $skipSections[] = $sk;
        }
    }
    if ($arg === '--report') { $reportPath = ''; }
    if (str_starts_with($arg, '--report=')) { $reportPath = substr($arg, 9); }
}

if (!empty($ignorePaths)) {
    \SatuRumah\Forensic\Core\FileSystem::setIgnorePrefixes($ignorePaths);
}

$config = new Config($target, $showFindings);

if (!$jsonMode) {
    echo "\n\033[1;35m╔══════════════════════════════════════════════════════════════════════════╗\n";
    echo "║     BONA FORENSIC — Enterprise Audit (Modular Architecture)              ║\n";
    echo "╚══════════════════════════════════════════════════════════════════════════╝\033[0m\n";
    echo "  Target : {$target}\n";
    if ($showFindings) echo "  Mode   : \033[1;33mFULL FINDINGS\033[0m\n";
    if ($onlySection !== null) echo "  Filter : \033[1;33m{$onlySection}\033[0m\n";
    if (!empty($ignorePaths)) echo "  Ignore : \033[1;33m" . implode(', ', $ignorePaths) . "\033[0m\n";
    if (!empty($skipSections)) echo "  Skip   : \033[1;33m" . implode(', ', $skipSections) . "\033[0m\n";
    if ($reportPath !== null) echo "  Report : \033[1;33m" . ($reportPath === '' ? '(auto)' : $reportPath) . "\033[0m\n";
    echo "\n";
}

$checkers = [
    new StatsChecker($config),
    new MaintenanceChecker($config),
    new DependencyChecker($config),
    new CircularDependencyChecker($config),
    new ImportDepthChecker($config),
    new CentralityChecker($config),
    new BrokenLinksChecker($config),
    new PageSpeedChecker($config),
    new AssetChecker($config),
    new ReliabilityChecker($config),
    new OrphanChecker($config),
    new SecurityChecker($config),
    new AdvancedSecurityChecker($config),
    new ConfigChecker($config),
    new DatabaseChecker($config),
    new Php2ShellChecker($config),
    new SemgrepChecker($config),
    new PhpUnitChecker($config),
    new SmokeTestChecker($config),
    new LogChecker($config),
    new SeoChecker($config),
    new ClsChecker($config),
    new TtfbChecker($config),
    new A11yChecker($config),
];

// v2.2.5-A: --skip=SECTION filter (substring match on getName)
if (!empty($skipSections)) {
    $checkers = array_values(array_filter($checkers, function ($c) use ($skipSections) {
        $name = $c->getName();
        foreach ($skipSections as $sk) {
            if (stripos($name, $sk) !== false) return false;
        }
        return true;
    }));
}

// Special case: --section=integrity butuh full pipeline (snapshot + run + compare)
if ($onlySection === 'integrity') {
    $integrity = new IntegrityChecker($config);
    $integrity->snapshot();
    // Jalankan semua checker (silent) - tidak mengubah file, hanya untuk duration realistis
    foreach ($checkers as $c) { $c->run(); }
    echo "\033[1;36m▶ Running: Read-Only Integrity Check\033[0m\n";
    $results = $integrity->run();
    foreach ($results as $res) {
        $icon = match($res['status']) { 'PASS' => "\033[0;32m✓\033[0m", 'FAIL' => "\033[0;31m✗\033[0m", 'WARN' => "\033[0;33m⚠\033[0m", default => "\033[0;34mℹ\033[0m" };
        echo "  {$icon} {$res['message']}\n";
        foreach (($res['details']['list'] ?? []) as $item) echo "      \033[2m- {$item}\033[0m\n";
    }
    echo "\n";
    exit($results[0]['status'] === 'FAIL' ? 1 : 0);
}

if ($onlySection !== null) {
    $checkers = array_filter($checkers, fn($c) => stripos($c->getName(), $onlySection) !== false);
    if (empty($checkers)) { echo "\033[0;31mNo section matched '{$onlySection}'\033[0m\n"; exit(1); }
}

$allResults = [];
$totalFails = 0;
$totalWarns = 0;

// Snapshot SEBELUM audit (untuk bukti read-only)
$integrity = new IntegrityChecker($config);
$integrity->snapshot();


foreach ($checkers as $checker) {
    $results = $checker->run();
    $allResults[$checker->getName()] = $results;
    
    if (!$jsonMode) {
        echo "\033[1;36m▶ Running: " . $checker->getName() . "\033[0m\n";
        foreach ($results as $res) {
            $icon = match($res['status']) {
                'PASS' => "\033[0;32m✓\033[0m", 'FAIL' => "\033[0;31m✗\033[0m",
                'WARN' => "\033[0;33m⚠\033[0m", 'SKIP' => "\033[0;90m○\033[0m", default => "\033[0;34mℹ\033[0m"
            };
            echo "  {$icon} {$res['message']}\n";
            if (in_array($res['status'], ['FAIL', 'WARN', 'INFO']) && !empty($res['details']['list'])) {
                $list = $res['details']['list'];
                $items = $showFindings ? $list : array_slice($list, 0, 10);
                foreach ($items as $item) echo "      \033[2m- {$item}\033[0m\n";
                if (!$showFindings && count($list) > 10) echo "      \033[2m... dan " . (count($list) - 10) . " lainnya\033[0m\n";
            }
        }
        echo "\n";
    }
    
    foreach ($results as $res) {
        if ($res['status'] === 'FAIL') $totalFails++;
        if ($res['status'] === 'WARN') $totalWarns++;
    }
}

if ($onlySection === null) {
    echo "\033[1;36m▶ Running: Read-Only Integrity Check\033[0m\n";
    $integrityResults = $integrity->run();
    $allResults['Read-Only Integrity Check'] = $integrityResults;
    foreach ($integrityResults as $res) {
        $icon = match($res['status']) { 'PASS' => "\033[0;32m✓\033[0m", 'FAIL' => "\033[0;31m✗\033[0m", 'WARN' => "\033[0;33m⚠\033[0m", default => "\033[0;34mℹ\033[0m" };
        echo "  {$icon} {$res['message']}\n";
        foreach (($res['details']['list'] ?? []) as $item) echo "      \033[2m- {$item}\033[0m\n";
    }
    echo "\n";
    
    $snapshotChecker = new SnapshotChecker($config, $allResults);
    $snapshotResults = $snapshotChecker->run();
    if (!$jsonMode) {
        echo "\033[1;36m▶ Running: Snapshot & Diff\033[0m\n";
        foreach ($snapshotResults as $res) {
            $icon = match($res['status']) { 'PASS' => "\033[0;32m✓\033[0m", 'WARN' => "\033[0;33m⚠\033[0m", 'INFO' => "\033[0;34mℹ\033[0m", default => "\033[0;90m○\033[0m" };
            echo "  {$icon} {$res['message']}\n";
        }
        echo "\n";
    }
}

if ($jsonMode) {
    echo json_encode(['meta' => ['target' => $target, 'timestamp' => date('c')], 'summary' => ['fails' => $totalFails, 'warns' => $totalWarns, 'status' => $totalFails > 0 ? 'FAIL' : ($totalWarns > 0 ? 'WARN' : 'PASS')], 'results' => $allResults], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n";
} else {
    echo "\033[1;35m══════════════════════════════════════════════════════════════════════════\033[0m\n";
    echo "\033[1;35m  SUMMARY\033[0m\n";
    echo "  Total FAILs : \033[0;31m{$totalFails}\033[0m\n";
    echo "  Total WARNs : \033[0;33m{$totalWarns}\033[0m\n";
    echo "  Status      : " . ($totalFails > 0 ? "\033[0;31mFAIL\033[0m" : ($totalWarns > 0 ? "\033[0;33mWARN\033[0m" : "\033[0;32mPASS\033[0m")) . "\n";
    echo "\033[1;35m══════════════════════════════════════════════════════════════════════════\033[0m\n\n";
}

    // ═══════════════════════════════════════════════════════════════
    // v2.2.5-D ops2: grouped-by-severity summary (non-json only)
    // ═══════════════════════════════════════════════════════════════
    $grouped = ['FAIL' => [], 'WARN' => [], 'PASS' => [], 'SKIP' => [], 'INFO' => []];
    foreach ($allResults as $checkerName => $checks) {
        foreach ($checks as $res) {
            $st = $res['status'] ?? 'INFO';
            if (!isset($grouped[$st])) $grouped[$st] = [];
            $grouped[$st][] = ['checker' => (string)$checkerName, 'message' => (string)($res['message'] ?? '')];
        }
    }

    if (!$jsonMode) {
        echo "\033[1;35m══════════════════════════════════════════════════════════════════════════\033[0m\n";
        echo "\033[1;35m  📊 GROUPED BY SEVERITY\033[0m\n";
        echo "\033[1;35m" . str_repeat('─', 74) . "\033[0m\n";

        $sevIcons = ['FAIL' => "\033[0;31m✗\033[0m", 'WARN' => "\033[0;33m⚠\033[0m",
                     'SKIP' => "\033[0;90m○\033[0m"];
        foreach (['FAIL', 'WARN', 'SKIP'] as $sev) {
            if (empty($grouped[$sev])) continue;
            echo "  {$sevIcons[$sev]} {$sev} (" . count($grouped[$sev]) . "):\n";
            foreach (array_slice($grouped[$sev], 0, 10) as $item) {
                $msg = strlen($item['message']) > 68 ? substr($item['message'], 0, 65) . '...' : $item['message'];
                echo "      \033[2m- [{$item['checker']}] {$msg}\033[0m\n";
            }
            if (count($grouped[$sev]) > 10) echo "      \033[2m... and " . (count($grouped[$sev]) - 10) . " more\033[0m\n";
        }
        if (!empty($grouped['PASS'])) {
            $rawNames = array_map(static fn(array $i): string => $i['checker'], $grouped['PASS']);
            $uniqueNames = array_values(array_unique($rawNames));
            $totalResults = count($rawNames);
            $uniqueCount = count($uniqueNames);
            $headerLabel = $totalResults === $uniqueCount
                ? "PASS ({$totalResults})"
                : "PASS ({$totalResults} across {$uniqueCount} checkers)";
            $shown = implode(', ', array_slice($uniqueNames, 0, 8));
            $suffix = $uniqueCount > 8 ? ', ...' : '';
            echo "  \033[0;32m✓\033[0m {$headerLabel}: \033[2m{$shown}{$suffix}\033[0m\n";
        }
        echo "\033[1;35m══════════════════════════════════════════════════════════════════════════\033[0m\n\n";
    }

    // ═══════════════════════════════════════════════════════════════
    // v2.2.5-D ops3: --report markdown generator
    // ═══════════════════════════════════════════════════════════════
    if ($reportPath !== null) {
        $finalPath = $reportPath;
        if ($finalPath === '') {
            $finalPath = $config->getToolDir() . '/.bona/reports/report-' . date('Ymd-His') . '.md';
        }
        $reportDir = dirname($finalPath);
        if (!is_dir($reportDir)) @mkdir($reportDir, 0755, true);

        $toolHead = trim((string)shell_exec('cd ' . escapeshellarg($config->getToolDir()) . ' && git rev-parse --short HEAD 2>/dev/null'));
        $reportStatus = $totalFails > 0 ? 'FAIL' : ($totalWarns > 0 ? 'WARN' : 'PASS');

        $md = "# Bona Forensic Audit Report\n\n";
        $md .= "**Generated:** " . date('c') . "\n\n";
        $md .= "**Target:** `" . $config->getTargetDir() . "`\n\n";
        $md .= "**Tool:** `bona-cms-forensic` @ " . ($toolHead !== '' ? $toolHead : 'unknown') . "\n\n";
        $md .= "**Status:** **{$reportStatus}**\n\n";
        $md .= "> Read-only audit. No target files were modified. Findings are informational — no automated fixes applied.\n\n";
        $md .= "---\n\n## Executive Summary\n\n";
        $md .= "| Status | Count |\n|---|---|\n";
        $md .= "| ✗ FAIL | " . count($grouped['FAIL']) . " |\n";
        $md .= "| ⚠ WARN | " . count($grouped['WARN']) . " |\n";
        $md .= "| ✓ PASS | " . count($grouped['PASS']) . " |\n";
        $md .= "| ○ SKIP | " . count($grouped['SKIP']) . " |\n";
        if (!empty($grouped['INFO'])) $md .= "| ℹ INFO | " . count($grouped['INFO']) . " |\n";
        $md .= "\n## Findings\n\n";

        foreach (['FAIL', 'WARN'] as $sev) {
            if (empty($grouped[$sev])) continue;
            $icon = $sev === 'FAIL' ? '✗' : '⚠';
            $md .= "### {$icon} {$sev} (" . count($grouped[$sev]) . ")\n\n";
            foreach ($grouped[$sev] as $item) {
                $md .= "#### {$item['checker']}\n\n{$item['message']}\n\n";
            }
        }
        if (!empty($grouped['PASS'])) {
            $md .= "### ✓ PASS (" . count($grouped['PASS']) . ")\n\n";
            foreach ($grouped['PASS'] as $item) $md .= "- **{$item['checker']}**: {$item['message']}\n";
            $md .= "\n";
        }
        if (!empty($grouped['SKIP'])) {
            $md .= "### ○ SKIP (" . count($grouped['SKIP']) . ")\n\n";
            foreach ($grouped['SKIP'] as $item) $md .= "- **{$item['checker']}**: {$item['message']}\n";
            $md .= "\n";
        }
        $md .= "---\n\n*Generated by Bona Forensic — read-only audit tool.*\n";

        $tmp = $finalPath . '.tmp';
        $ok = @file_put_contents($tmp, $md);
        if ($ok !== false) {
            @rename($tmp, $finalPath);
            if (!$jsonMode) echo "  📄 Report written: \033[1;33m{$finalPath}\033[0m\n\n";
            else fwrite(STDERR, "Report written: {$finalPath}\n");
        } else {
            if (!$jsonMode) echo "  ⚠ Report write failed: {$finalPath}\n\n";
        }
    }


// ═══════════════════════════════════════════════════════════════
// v2.6.0: --html self-contained report (uses $allResults aggregate)
// ═══════════════════════════════════════════════════════════════
if ($htmlFlag !== null) {
    $flat = [];
    foreach ($allResults as $cn => $checks) {
        foreach ($checks as $c) {
            $c['name'] = (string)$cn;
            $flat[] = $c;
        }
    }
    $htmlOut = $htmlFlag !== '' ? $htmlFlag : $config->getToolDir() . '/.bona/report-' . date('Ymd-His') . '.html';
    try {
        \SatuRumah\Forensic\Report\HtmlReport::render($flat, $target, $htmlOut, '2.2.5');
        fwrite(STDOUT, "  📄 HTML report: {$htmlOut}\n");
    } catch (\Throwable $e) {
        fwrite(STDERR, "  ⚠ HTML report failed: " . $e->getMessage() . "\n");
    }
}


exit($totalFails > 0 ? 1 : 0);
